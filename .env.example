# ---------------------------------------------------------------------------
# MongoDB
# Local:  mongodb://127.0.0.1:27017/hotel-management
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-management?retryWrites=true&w=majority
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/hotel-management

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
# Generate a secret with:  npx auth secret     (or)  openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Public self-registration.
# "true"  -> /register is open and creates RECEPTIONIST accounts.
# "false" -> /register is disabled; only an admin can create users.
# ---------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true
