# ---------------------------------------------------------------------------
# MongoDB
#
# Local:   mongodb://127.0.0.1:27017/hotel-management
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hotel-management?retryWrites=true&w=majority
#
# The database name is applied in code (MONGODB_DB_NAME, default
# "hotel-management"), so a connection string copied straight from the Atlas
# dashboard still works even though it ends at the host.
#
# URL-encode special characters in the password:  @ -> %40   # -> %23   / -> %2F
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/hotel-management
# MONGODB_DB_NAME=hotel-management

# ---------------------------------------------------------------------------
# DEPLOYING TO VERCEL / NETLIFY / ANY SERVERLESS HOST
#
# Serverless functions get a different outbound IP on every invocation, so the
# cluster must accept connections from anywhere:
#
#   Atlas > Network Access > Add IP Address > Allow access from anywhere
#   (0.0.0.0/0)
#
# Without this every request fails with "Cannot reach the database right now",
# even though the connection string is correct. Keep the database user's
# permissions tight, since the network is no longer the barrier.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Auth.js / NextAuth
#
# Generate a secret with:  npx auth secret   (or)  openssl rand -base64 32
# NEXTAUTH_URL must be the site's real public URL in production — it is used to
# build password-reset links.
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Public self-registration.
# "true"  -> /register is open and creates RECEPTIONIST accounts.
# "false" -> /register is disabled; only an admin can create users.
# ---------------------------------------------------------------------------
ALLOW_PUBLIC_REGISTRATION=true
